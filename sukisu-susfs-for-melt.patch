--- a/drivers/staging/kernelsu/allowlist.c	(revision da083de16ae631e7647781251bb89b0a86775e37)
+++ b/drivers/staging/kernelsu/allowlist.c	(revision 4257730413f007c76072d48f3302518eea139c4a)
@@ -8,7 +8,10 @@
 #include <linux/slab.h>
 #include <linux/types.h>
 #include <linux/version.h>
+#include <linux/kconfig.h>
